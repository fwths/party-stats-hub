{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://party-stats-hub.local/schemas/audit/finding.schema.json",
  "title": "Audit Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "severity",
    "confidence",
    "owner",
    "status",
    "lifecycle",
    "first_detected",
    "last_reviewed",
    "category",
    "location",
    "description",
    "impact",
    "recommendation",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ARC|DND|CMP|COD|CRT|DIR)-[0-9]{3,}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "severity": {
      "enum": ["Critical", "High", "Medium", "Low", "Info"]
    },
    "confidence": { "enum": ["High", "Medium", "Low"] },
    "owner": {
      "enum": [
        "Architecture & Data Model Agent",
        "D&D Domain Agent",
        "Campaign & Collaboration Agent",
        "Code Quality & Reliability Agent",
        "Critic Agent",
        "Repository Director"
      ]
    },
    "status": {
      "enum": ["Open", "Accepted", "In Progress", "Resolved", "Rejected"]
    },
    "lifecycle": { "enum": ["New", "Existing", "Resolved", "Regressed"] },
    "first_detected": { "$ref": "#/$defs/date" },
    "last_reviewed": { "$ref": "#/$defs/date" },
    "category": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "location": { "$ref": "#/$defs/location" },
    "description": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "evidence": { "$ref": "#/$defs/evidence" },
    "notes": { "type": "string", "default": "" }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "symbols",
        "lines",
        "observed_behavior",
        "expected_behavior",
        "rationale"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lines": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_behavior": { "type": "string", "minLength": 1 },
        "expected_behavior": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "reproduction": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    }
  }
}
